<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragments.auth.ImportMnemoFragment">


    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/app_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:elevation="1dp">

            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:background="@color/white"
                android:id="@+id/toolbar_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:title="@string/title_import_mnemo"
                app:expandedTitleGravity="center_horizontal"
                app:collapsedTitleGravity="left"
                app:collapsedTitleTextAppearance="@style/text_toolbar_title"
                app:collapsedTitleTextColor="#00FFFFFF"
                app:expandedTitleMarginTop="@dimen/collaps_toolbar_title_margin_top"
                app:expandedTitleTextColor="#00FFFFFF"
                app:expandedTitleTextAppearance="@style/text_toolbar_title_expand"
                app:popupTheme="@style/text_toolbar_title"
                app:layout_scrollFlags="snap|scroll|exitUntilCollapsed"
                app:toolbarId="@+id/toolbar">

                <com.yellastro.mytonwallet.views.MaxCharsTextView
                    android:id="@+id/fr_import_mnemo_desc"
                    style="@style/text_general"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/collaps_toolbar_subtitle_margin_top"
                    android:layout_marginHorizontal="@dimen/margin_48"
                    android:layout_marginBottom="32dp"
                    app:layout_collapseMode="parallax"
                    android:layout_gravity="top"
                    android:lineSpacingExtra="4dp"
                    android:text="You can restore access to your wallet by entering the 24 secret words that you wrote down when creating the wallet."/>


                <androidx.appcompat.widget.Toolbar
                    app:titleTextAppearance="@style/text_toolbar_title"
                    android:id="@+id/toolbar"
                    android:background="@color/white"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/margin_64"
                    app:layout_collapseMode="pin"
                    app:layout_scrollFlags="scroll|enterAlways"
                    android:fadingEdgeLength="0dp"
                    app:navigationIcon="@drawable/ic_back"/>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="top"
                    app:layout_collapseMode="pin">

                    <TextView
                        android:id="@+id/fr_imort_mnemo_title_colps"
                        style="@style/text_toolbar_title"
                        android:visibility="invisible"
                        android:gravity="center"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/margin_64"
                        android:layout_marginStart="46dp"
                        android:text="@string/title_import_mnemo"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <TextView
                        android:id="@+id/fr_imort_mnemo_title_exp"
                        style="@style/text_toolbar_title"
                        android:textSize="28sp"
                        android:gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/margin_64"
                        android:layout_marginBottom="82dp"
                        android:text="@string/title_import_mnemo"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.appbar.CollapsingToolbarLayout>
        </com.google.android.material.appbar.AppBarLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/fr_input_mnemo_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/fr_import_mnemo_input_lay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:orientation="vertical">

                </LinearLayout>

                <Button
                    android:id="@+id/fr_import_mneno_btn_done"
                    style="@style/button_general"
                    android:text="@string/btn_continue" />
            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>



</androidx.constraintlayout.widget.ConstraintLayout>
