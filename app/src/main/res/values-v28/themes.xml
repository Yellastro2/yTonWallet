<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="text_big" parent="text_general">
        <item name="android:textSize">@dimen/text_size_big</item>
        <item name="android:textFontWeight">500</item>
        <!--        <item name="android:textStyle">bold</item>-->
    </style>

    <style name="text_toolbar_title" parent="text_general">
        <item name="android:textSize">@dimen/text_size_22</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="text_toolbar_title_expand" parent="text_general">

        <item name="android:textSize">@dimen/text_size_big</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="button_general" parent="@android:style/Widget.Button">
        <item name="android:textFontWeight">600</item>
        <item name="android:textSize">@dimen/text_size_regular</item>
        <item name="android:background">@drawable/select_button</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:layout_marginTop">@dimen/margin_32</item>
        <item name="android:layout_marginHorizontal">@dimen/button_main_horz_margin</item>
        <item name="android:layout_marginVertical">@dimen/button_main_vert_margin</item>
        <item name="android:layout_width">match_parent</item>
    </style>
</resources>